{
    "name": "cyberwizard/watchtower-agent",
    "description": "Companion to laravel/nightwatch that sends schedule, queue, worker, output, health, catch-up, event, broadcast, cache, mail, HTTP and webhook records to a self-hosted Watch Tower backend.",
    "keywords": [
        "laravel",
        "nightwatch",
        "watch-tower",
        "monitoring",
        "scheduler",
        "queue",
        "events",
        "broadcasting",
        "mail",
        "webhooks"
    ],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "laravel/nightwatch": "^1.28"
    },
    "require-dev": {
        "cyberwizard/schedule-catchup": "^1.2.1",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "suggest": {
        "cyberwizard/schedule-catchup": "Replays missed scheduled events; the agent reports each replay and outage to Watch Tower (^1.1, per-occurrence events from ^1.2).",
        "spatie/laravel-webhook-server": "Outgoing webhook calls are reported as wt-http records tagged as webhooks."
    },
    "autoload": {
        "psr-4": {
            "Cyberwizard\\WatchtowerAgent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cyberwizard\\WatchtowerAgent\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cyberwizard\\WatchtowerAgent\\WatchtowerAgentServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "pest",
        "format": "pint"
    },
    "homepage": "https://github.com/cyberwizard-dev/watchtower-agent"
}
